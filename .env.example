# ─────────────────────────────────────────────────────────────────────
#  python-face-service  –  Environment Variables Template
#
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env to version control.
#  This .env.example file is safe to commit.
# ─────────────────────────────────────────────────────────────────────

# Application
APP_NAME=python-face-service
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true                    # set false in production

# ── Camera ─────────────────────────────────────────────────────────────
# CAMERA_SOURCE=laptop → use laptop webcam via cv2.VideoCapture(CAMERA_INDEX)
# CAMERA_SOURCE=esp32  → use MJPEG stream from ESP32_CAMERA_URL
CAMERA_SOURCE=laptop
CAMERA_INDEX=0
ESP32_CAMERA_URL=http://192.168.1.100   # only used when CAMERA_SOURCE=esp32
CAPTURE_COUNT=20
FRAME_WIDTH=640
FRAME_HEIGHT=480

# ── Face Recognition ────────────────────────────────────────────────────
# RECOGNITION_THRESHOLD: raw L2 distance cutoff.
# Lower = stricter. Typical range for MediaPipe: 0.35 – 0.55
RECOGNITION_THRESHOLD=0.50
DETECTION_MODEL=hog           # hog (CPU) | cnn (GPU, not supported on Windows)
ENCODING_JITTERS=1

# ── File Paths ──────────────────────────────────────────────────────────
UPLOAD_DIR=uploads/students
TEMP_DIR=uploads/temp
ENCODING_DIR=encodings
LOG_DIR=logs

# ── Database ─────────────────────────────────────────────────────────────
# SQLite for local/development use
DATABASE_URL=sqlite:///./face_service.db
# PostgreSQL example (do NOT commit real credentials):
# DATABASE_URL=postgresql://user:password@localhost:5432/face_service_db

# ── Spring Boot Integration ─────────────────────────────────────────────
# Set SPRING_BOOT_BASE_URL to your Spring Boot service address.
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_ATTENDANCE_ENDPOINT=/api/attendance/save
SPRING_BOOT_STUDENT_ENDPOINT=/api/students
SPRING_BOOT_TIMEOUT=10        # seconds before HTTP timeout

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_MAX_BYTES=10485760        # 10 MB per log file
LOG_BACKUP_COUNT=5
